# Copy to .env for Docker Compose. Every value below is development-only.
# Never reuse these placeholders in a shared or production environment.

# Local PostgreSQL
POSTGRES_DB=goldenhour
POSTGRES_USER=goldenhour
POSTGRES_PASSWORD=GoldenHour-Local-Postgres-Only-2026!
POSTGRES_PORT=5432

# Local API and browser
API_PORT=8080
ASPNETCORE_ENVIRONMENT=Development
DATABASE_USE_IN_MEMORY=false
DATABASE_MIGRATE_ON_STARTUP=true
PUBLIC_APP_URL=http://localhost:8080
EMERGENCY_NUMBER=112
AI_CONFIDENCE_THRESHOLD=0.7

# Development-only authentication and seed data
# Use at least 32 random characters for JWT_SIGNING_KEY.
JWT_SIGNING_KEY=GoldenHour-Local-JWT-Signing-Key-Change-Before-Sharing-2026!
JWT_ISSUER=GoldenHourAI
JWT_AUDIENCE=GoldenHourAI.Web
ACCESS_TOKEN_MINUTES=10
REFRESH_TOKEN_DAYS=7
DEMO_PASSWORD=GoldenHour-Demo-Only-2026!
WEBHOOK_SIGNING_SECRET=GoldenHour-Local-Webhook-Only-2026!
WEBHOOK_ALLOWED_CLOCK_SKEW_MINUTES=5

# Provider selection. Mock mode is the safe, deterministic default.
USE_MOCK_PROVIDERS=true
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
OPENAI_BASE_URL=https://api.openai.com/v1/
OPENAI_TIMEOUT_SECONDS=15

# Optional Azure provider settings. Leave empty for local mock mode.
AZURE_STORAGE_CONNECTION_STRING=
AZURE_SIGNALR_CONNECTION_STRING=
AZURE_SERVICE_BUS_CONNECTION_STRING=
APPLICATIONINSIGHTS_CONNECTION_STRING=

# Vite uses same-origin defaults in production. These are only needed when
# running the Vite development server against a different API origin.
VITE_API_BASE_URL=http://localhost:8080
VITE_SIGNALR_HUB_URL=http://localhost:8080/hubs/emergency
VITE_MOCK_MODE=true
VITE_EMERGENCY_NUMBER=112
