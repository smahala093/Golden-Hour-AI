{
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "GoldenHour": "Host=localhost;Port=5432;Database=goldenhour;Username=goldenhour;Password=development-only"
  },
  "Authentication": {
    "Jwt": {
      "Issuer": "GoldenHourAI",
      "Audience": "GoldenHourAI.Web",
      "SigningKey": ""
    },
    "AccessTokenMinutes": 10,
    "RefreshTokenDays": 7
  },
  "Emergency": {
    "DefaultNumber": "112",
    "AiConfidenceThreshold": 0.7
  },
  "OpenAI": {
    "BaseUrl": "https://api.openai.com/v1/",
    "Model": "gpt-4.1-mini",
    "SpeechModel": "gpt-4o-mini-transcribe",
    "TextToSpeechModel": "tts-1",
    "TextToSpeechVoice": "alloy",
    "ApiKey": "",
    "TimeoutSeconds": 15
  },
  "Providers": {
    "UseMocks": true
  },
  "SmsGateway": {
    "Enabled": false,
    "Endpoint": "",
    "SigningSecret": "",
    "TimeoutSeconds": 10,
    "MaximumResponseBytes": 65536
  },
  "Webhook": {
    "Enabled": true,
    "SigningSecret": "",
    "AllowedClockSkewMinutes": 5
  },
  "Security": {
    "RequireHttps": true,
    "UseForwardedHeaders": false,
    "KnownProxies": []
  },
  "Seed": {
    "DemoPassword": ""
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  }
}
